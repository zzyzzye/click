{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure (Windows)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "windows-vs2026-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "CMake: Build ClickFlow (Windows)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "windows-vs2026-build",
        "--target",
        "ClickFlow"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": "CMake: Configure (Windows)"
    },
    {
      "label": "CMake: Configure (macOS)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "macos-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "CMake: Build ClickFlow (macOS)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "build",
        "--target",
        "ClickFlow"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": "CMake: Configure (macOS)",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
