{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure (Windows)",
      "type": "process",
      "command": "C:/Program Files/Microsoft Visual Studio/18/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmake.exe",
      "args": [
        "--preset",
        "windows-local"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "CMake: Build ClickFlow (Windows)",
      "type": "process",
      "command": "C:/Program Files/Microsoft Visual Studio/18/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmake.exe",
      "args": [
        "--build",
        "--preset",
        "windows-vs2026-build",
        "--target",
        "QtClicker"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "CMake: Configure (macOS)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "macos-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "CMake: Build ClickFlow (macOS)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "build",
        "--target",
        "QtClicker"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    }
  ]
}
